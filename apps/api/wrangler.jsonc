{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "edgekit-platform",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REALTIME",
        "class_name": "RealtimeDurableObject"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RealtimeDurableObject"
      ]
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "edgekit-platform-db",
      "database_id": "local-edgekit-platform-d1-id",
      "migrations_dir": "../../drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "STORAGE_BUCKET",
      "bucket_name": "edgekit-platform-storage"
    }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "CLOUDFLARE_PLAN": "free",
    "ENABLE_FUNCTIONS": "false",
    "ENABLE_DYNAMIC_WORKERS": "false",
    "APP_NAME": "Edgekit Platform",
    "APP_VERSION": "1.0.0"
  }
}
