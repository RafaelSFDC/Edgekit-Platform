{
  "name": "edgekit-platform",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Serverless, open-source Backend-as-a-Service on Cloudflare Workers, D1, R2, and Durable Objects - Edgekit Platform",
  "scripts": {
    "dev": "concurrently -n \"api,web\" -c \"magenta,cyan\" \"pnpm --filter @edgekit/platform-api dev\" \"pnpm --filter @edgekit/platform-web dev\"",
    "dev:all": "concurrently -n \"api,web,demo\" -c \"magenta,cyan,yellow\" \"pnpm --filter @edgekit/platform-api dev\" \"pnpm --filter @edgekit/platform-web dev\" \"pnpm --filter @edgekit/demo-app dev\"",
    "dev:api": "pnpm --filter @edgekit/platform-api dev",
    "dev:web": "pnpm --filter @edgekit/platform-web dev",
    "dev:demo": "pnpm --filter @edgekit/demo-app dev",
    "setup": "tsx scripts/setup.ts",
    "setup:local": "tsx scripts/setup.ts --local",
    "setup:cf": "tsx scripts/setup-cloudflare.ts",
    "keys:generate": "tsx scripts/generate-keys.ts",
    "db:generate": "drizzle-kit generate && tsx scripts/bundle-d1-migrations.ts",
    "db:migrate:prod": "tsx scripts/migrate-d1-prod.ts",
    "db:migrate:prod:list": "tsx scripts/migrate-d1-prod.ts --list",
    "db:studio": "drizzle-kit studio",
    "db:typegen": "tsx scripts/generate-types.ts",
    "build:client": "pnpm --filter @edgekit/platform-client build",
    "build:web": "pnpm --filter @edgekit/platform-web build",
    "build:api": "pnpm --filter @edgekit/platform-api build",
    "build": "pnpm --filter @edgekit/platform-client build && pnpm --filter @edgekit/platform-web build && pnpm --filter @edgekit/platform-api build",
    "deploy:check": "tsx scripts/check-deploy.ts",
    "deploy": "pnpm deploy:check && pnpm --filter @edgekit/platform-client build && pnpm --filter @edgekit/platform-web build && pnpm --filter @edgekit/platform-api deploy",
    "cf-typegen": "pnpm --filter @edgekit/platform-api cf-typegen",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 run test",
    "test:api": "pnpm --filter @edgekit/platform-api test",
    "test:web": "pnpm --filter @edgekit/platform-web test",
    "test:consumer": "pnpm --filter @edgekit/demo-app test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "oxlint"
  },
  "keywords": [
    "edgekit",
    "cloudflare",
    "workers",
    "d1",
    "r2",
    "durable-objects",
    "websockets",
    "hono",
    "serverless",
    "baas",
    "supabase"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "^9.1.2",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.10",
    "oxc-transform-react": "0.156.0",
    "oxlint": "^1.90.0",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
