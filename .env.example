# ==========================================
# HONOBASE CONFIGURATION (Serverless BaaS)
# ==========================================
ENVIRONMENT=development
APP_NAME=HonoBase
APP_VERSION=0.1.0
APP_URL=http://localhost:3000

# ==========================================
# AUTHENTICATION & SECURITY KEYS
# Gere chaves seguras executando: pnpm keys:generate
# ==========================================
BETTER_AUTH_SECRET=dev-secret-replace-me-in-production-1234567890abcdef
HONOBASE_ANON_KEY=honobase_anon_dev_key_sample
HONOBASE_SERVICE_ROLE_KEY=honobase_service_role_dev_key_sample

# ==========================================
# DATABASE & STORAGE (Local Fallbacks)
# ==========================================
DATABASE_URL=dev.db
LOCAL_STORAGE_PATH=.local/storage

# ==========================================
# CLOUDFLARE PLAN CAPABILITIES
# Plano Free: D1, R2 e Durable Objects ativos (100% suportados no Free)
# Plano Pago: Apenas necessário para Dynamic Workers (Workers for Platforms)
# ==========================================
CLOUDFLARE_PLAN=free
ENABLE_DYNAMIC_WORKERS=false

# ==========================================
# OPTIONAL SOCIAL PROVIDERS (OAuth)
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
