# ==========================================
# EDGEKIT PLATFORM CONFIGURATION (Serverless BaaS)
# ==========================================
ENVIRONMENT=development
APP_NAME=Edgekit Platform
APP_VERSION=1.0.0
APP_URL=http://localhost:5173

# ==========================================
# AUTHENTICATION & SECURITY KEYS
# Gere chaves seguras executando: pnpm keys:generate
# ==========================================
EDGEKIT_SERVICE_ROLE_KEY=
EDGEKIT_ANON_KEY=
BETTER_AUTH_SECRET=

# ==========================================
# DATABASE & STORAGE (Local Fallbacks)
# ==========================================
DATABASE_URL=dev.db
LOCAL_STORAGE_PATH=.local/storage

# ==========================================
# CLOUDFLARE PLAN CAPABILITIES
# Plano Free: D1, R2 e Durable Objects ativos (100% suportados no Free)
# Plano Pago: Apenas necessário se quiser Dynamic Workers (Workers for Platforms)
# ==========================================
CLOUDFLARE_PLAN=free
ENABLE_FUNCTIONS=false
ENABLE_DYNAMIC_WORKERS=false

# ==========================================
# OPTIONAL SOCIAL PROVIDERS (OAuth)
# ==========================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
